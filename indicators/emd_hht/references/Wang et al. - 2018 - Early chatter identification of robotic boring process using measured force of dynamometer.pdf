      <rdf:Description rdf:about=""
            xmlns:pdf="http://ns.adobe.com/pdf/1.3/">
         <pdf:Keywords>Robotic boring; Chatter; Empirical mode decomposition; Hilbert-Huang transform; Feature extraction</pdf:Keywords>
         <pdf:Producer>Acrobat Distiller 9.0.0 (Windows)</pdf:Producer>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:identifier>10.1007/s00170-017-0941-6</dc:identifier>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Early chatter identification of robotic boring process using measured force of dynamometer</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Int J Adv Manuf Technol, doi:10.1007/s00170-017-0941-6</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:publisher>
            <rdf:Bag>
               <rdf:li>The International Journal of Advanced Manufacturing Technology</rdf:li>
            </rdf:Bag>
         </dc:publisher>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Guifeng Wang</rdf:li>
               <rdf:li>Huiyue Dong</rdf:li>
               <rdf:li>Yingjie Guo</rdf:li>
               <rdf:li>Yinglin Ke</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>Robotic boring</rdf:li>
               <rdf:li>Chatter</rdf:li>
               <rdf:li>Empirical mode decomposition</rdf:li>
               <rdf:li>Hilbert-Huang transform</rdf:li>
               <rdf:li>Feature extraction</rdf:li>
            </rdf:Bag>
         </dc:subject>
      </rdf:Description>
